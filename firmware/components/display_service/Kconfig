menu "Temperature monitor LCD"

config MONITOR_LCD_ST7735
	bool "Use 128x160 ST7735 LCD"
	default y
	help
		Select the connected 1.8-inch ST7735 module. Disable for the
		original 240x320 ST7789 display.

config MONITOR_LCD_TEST_PATTERN
	bool "Show LCD color and orientation diagnostics"
	default n
	help
		Replace the normal display view with RGB bars and corner markers for
		physical panel bring-up. Keep disabled for normal firmware builds.

config MONITOR_LCD_FLUSH_DIAG
	bool "Log LVGL flush-to-completion timing on the normal UI"
	default n
	help
		Log LCD_DIAG flush_to_wait_complete_us for each LVGL flush while the
		normal display view runs. This is software transfer timing, not optical
		refresh latency, and the interval ends at LVGL's next flush wait, so
		it is only meaningful for back-to-back flushes; a lone repaint reports
		the time until the next repaint. Keep disabled for normal firmware builds.

endmenu
