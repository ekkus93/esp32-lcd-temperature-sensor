menu "Temperature monitor LCD"

config MONITOR_LCD_ST7735
	bool "Use 128x160 ST7735 LCD"
	default y
	help
		Select the connected 1.8-inch ST7735 module. Disable for the
		original 240x320 ST7789 display.

config MONITOR_LCD_TEST_PATTERN
	bool "Show LCD color and orientation diagnostics"
	default n
	help
		Replace the normal display view with RGB bars and corner markers for
		physical panel bring-up. Keep disabled for normal firmware builds.

config MONITOR_LCD_FLUSH_DIAG
	bool "Log LVGL flush-to-transfer-complete timing on the normal UI"
	default n
	help
		Every ten seconds log LCD_DIAG flush_us with the cumulative count,
		minimum, average and maximum time from LVGL flush start to SPI transfer
		completion. This replaces esp_lvgl_port's transfer-done callback with an
		equivalent one that timestamps first. It is software timing, not optical
		refresh latency. Keep disabled for normal firmware builds.

endmenu
