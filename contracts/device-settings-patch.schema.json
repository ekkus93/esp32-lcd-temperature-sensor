{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:temperature-monitor:device-settings-patch:1",
  "title": "DeviceSettingsPatch",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "properties": {
    "units": { "enum": ["C", "F"] },
    "display_mode": { "enum": ["basic", "extended"] },
    "overview_seconds": { "type": "integer", "minimum": 5, "maximum": 300 },
    "trends_seconds": { "type": "integer", "minimum": 5, "maximum": 300 },
    "lookback_minutes": { "type": "integer", "minimum": 5, "maximum": 1440 },
    "timezone": {
      "enum": [
        "UTC",
        "America/Los_Angeles",
        "America/New_York",
        "Europe/London",
        "Europe/Berlin",
        "Asia/Tokyo",
        "Australia/Sydney"
      ]
    },
    "ntp_server": { "type": "string", "minLength": 1, "maxLength": 253 }
  }
}
