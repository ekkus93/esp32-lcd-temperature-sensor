{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:temperature-monitor:alerts:1",
  "title": "Alerts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "active",
    "events",
    "next_after",
    "has_more",
    "oldest_available",
    "event_log_healthy"
  ],
  "properties": {
    "active": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "since_uptime_ms", "since_utc_seconds"],
            "properties": {
              "state": { "enum": ["bus_fault", "wifi_disconnected"] },
              "since_uptime_ms": { "type": "integer", "minimum": 0 },
              "since_utc_seconds": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["rom_id", "name", "state", "since_uptime_ms", "since_utc_seconds"],
            "properties": {
              "rom_id": { "type": "string", "pattern": "^28[0-9a-f]{14}$" },
              "name": { "type": "string", "minLength": 1, "maxLength": 32 },
              "state": { "enum": ["high", "low", "disconnected"] },
              "since_uptime_ms": { "type": "integer", "minimum": 0 },
              "since_utc_seconds": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "boot_id",
          "kind",
          "rom_id",
          "previous",
          "state",
          "uptime_ms",
          "utc_seconds",
          "detail"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "boot_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
          "kind": {
            "enum": ["sensor_state", "wifi_state", "clock_sync", "reboot", "storage_error", "calibration_started", "calibration_ended"]
          },
          "rom_id": {
            "type": ["string", "null"],
            "pattern": "^28[0-9a-f]{14}$"
          },
          "previous": {
            "enum": [
              "normal",
              "high",
              "low",
              "unassigned",
              "disabled",
              "disconnected",
              "stale",
              "invalid",
              "bus_fault"
            ]
          },
          "state": {
            "enum": [
              "normal",
              "high",
              "low",
              "unassigned",
              "disabled",
              "disconnected",
              "stale",
              "invalid",
              "bus_fault"
            ]
          },
          "uptime_ms": { "type": "integer", "minimum": 0 },
          "utc_seconds": { "type": ["integer", "null"], "minimum": 0 },
          "detail": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        }
      }
    },
    "next_after": { "type": "integer", "minimum": 0 },
    "has_more": { "type": "boolean" },
    "oldest_available": { "type": ["integer", "null"], "minimum": 1 },
    "event_log_healthy": { "type": "boolean" }
  }
}
