{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:temperature-monitor:device-settings:1",
  "title": "DeviceSettings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "etag", "revision", "writable", "units", "display_mode", "overview_seconds", "trends_seconds", "lookback_minutes", "timezone", "ntp_server"],
  "properties": {
    "schema_version": { "const": 1 },
    "etag": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 0 },
    "writable": { "type": "boolean" },
    "units": { "enum": ["C", "F"] },
    "display_mode": { "enum": ["basic", "extended"] },
    "overview_seconds": { "type": "integer", "minimum": 5, "maximum": 300 },
    "trends_seconds": { "type": "integer", "minimum": 5, "maximum": 300 },
    "lookback_minutes": { "type": "integer", "minimum": 5, "maximum": 1440 },
    "timezone": { "enum": ["UTC", "America/Los_Angeles", "America/New_York", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Australia/Sydney"] },
    "ntp_server": { "type": "string", "minLength": 1, "maxLength": 253 }
  }
}
