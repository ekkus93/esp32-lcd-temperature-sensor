{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:temperature-monitor:snapshot:1",
  "title": "Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sequence",
    "uptime_ms",
    "simulated",
    "sensors",
    "bus_fault",
    "clock",
    "wifi",
    "logging",
    "boot_id",
    "firmware"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "simulated": {
      "type": "boolean"
    },
    "bus_fault": {
      "type": "boolean"
    },
    "sensors": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/definitions/sensor"
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utc", "synchronized"],
      "properties": {
        "utc": {
          "type": ["string", "null"]
        },
        "synchronized": {
          "type": "boolean"
        }
      }
    },
    "wifi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["offline", "connecting", "connected", "setup"]
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healthy",
        "interval_seconds",
        "storage_available",
        "storage_total_bytes",
        "storage_used_bytes"
      ],
      "properties": {
        "healthy": {
          "type": "boolean"
        },
        "interval_seconds": {
          "const": 300
        },
        "storage_available": {
          "type": "boolean"
        },
        "storage_total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "storage_used_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      }
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "partition", "ota_state"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "partition": { "type": "string", "maxLength": 16 },
        "ota_state": {
          "enum": ["new", "pending_verify", "valid", "invalid", "aborted", "unknown"]
        }
      }
    }
  },
  "definitions": {
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rom_id",
        "name",
        "state",
        "temperature_c",
        "last_seen_ms",
        "enabled",
        "order"
      ],
      "properties": {
        "rom_id": {
          "type": "string",
          "pattern": "^28[0-9a-f]{14}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "state": {
          "enum": [
            "normal",
            "high",
            "low",
            "unassigned",
            "disabled",
            "disconnected",
            "stale",
            "invalid",
            "bus_fault"
          ]
        },
        "temperature_c": {
          "type": ["number", "null"],
          "minimum": -75,
          "maximum": 145
        },
        "last_seen_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    }
  }
}
